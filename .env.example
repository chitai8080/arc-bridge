# Optional custom RPC endpoints. If empty, default public RPCs are used by wagmi.
VITE_SEPOLIA_RPC_URL=
VITE_BASE_SEPOLIA_RPC_URL=
VITE_ARC_TESTNET_RPC_URL=

# Optional App Kit config for frontend. Bridge does not require a kit key.
# Set to true only if you want to disable SDK error telemetry.
VITE_APPKIT_DISABLE_ERROR_REPORTING=false
